{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "5.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@pinball/maps": ["../../packages/maps/index.ts"],
      "@pinball/map-strangerthings": ["../../packages/maps/strangerthings/index.ts"],
      "@pinball/*": ["../../packages/*/src"]
    }
  }
}
