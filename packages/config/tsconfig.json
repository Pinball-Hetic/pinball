{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "ignoreDeprecations": "6.0",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@pinball/maps/backglass": ["../../packages/maps/backglass.ts"],
      "@pinball/maps/dmd": ["../../packages/maps/dmd.ts"],
      "@pinball/maps": ["../../packages/maps/index.ts"],
      "@pinball/map-strangerthings/backglass": ["../../packages/maps/strangerthings/backglass"],
      "@pinball/map-strangerthings/dmd": ["../../packages/maps/strangerthings/dmd"],
      "@pinball/map-strangerthings": ["../../packages/maps/strangerthings/index.ts"],
      "@pinball/*": ["../../packages/*/src"]
    }
  }
}
