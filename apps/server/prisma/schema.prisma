generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Game {
  id            String   @id @default(cuid())
  player        String // pseudo affiché — aléatoire aujourd'hui
  playerId      String? // réservé : future feature compte/pseudo (site web)
  code          String?  @unique // token de claim (QR) — null si pas encore généré
  mapId         String   @default("strangerthings") // map jouée
  score         Int
  maxCombo      Int      @default(0)
  maxMultiplier Int      @default(1)
  // Compteurs spécifiques à la map (ex ST : demogorgons/portals/hetic).
  counters      Json     @default("{}")
  durationS     Int      @default(0)
  createdAt     DateTime @default(now())

  @@index([score(sort: Desc)])
  @@index([createdAt])
  @@index([mapId, score(sort: Desc)])
}
